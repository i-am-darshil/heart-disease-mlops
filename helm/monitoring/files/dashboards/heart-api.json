    {
      "type": "timeseries",
      "title": "Share flagged as heart disease: live vs training",
      "description": "If the live share moves far from the training baseline, the patients being scored differ from the training data. Alert when the gap exceeds 20 points.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "heart:positive_rate:rate15m",
          "legendFormat": "live (15 min)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(heart_reference_positive_rate{job=\"heart-api\"})",
          "legendFormat": "training baseline",
          "refId": "B"
