        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(heart_inference_seconds_bucket{job=\"heart-api\"}[1m])))",
          "legendFormat": "p95 model only",
          "refId": "D"
